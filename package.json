{
  "name": "@use-nyte/nyte-server",
  "version": "0.0.0",
  "description": "Server code for Nyte.",
  "repository": "https://github.com/use-nyte/nyte-server",
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "coverage": "jest --coverage && open-cli coverage/lcov-report/index.html",
    "dev": "nest start --watch",
    "prepare": "husky",
    "start": "node dist/main",
    "test": "pnpm run test:unit && pnpm run e2e",
    "test:unit": "jest --runInBand",
    "e2e": "jest --config tests/jest-e2e.json --runInBand",
    "lint": "pnpm exec lint",
    "lint:fix": "pnpm exec lint --fix",
    "format": "pnpm exec format",
    "format:write": "pnpm exec format --write",
    "typecheck": "tsc --noEmit --incremental false",
    "docs:build": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.12",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/supertest": "7.2.1",
    "@use-nyte/eslint-config": "2.1.1",
    "@use-nyte/prettier-config": "2.0.4",
    "husky": "9.1.7",
    "open-cli": "9.0.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.11",
    "tsconfig-paths": "4.2.0",
    "typedoc": "0.28.20",
    "typedoc-docusaurus-theme": "1.4.3",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "tests",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
