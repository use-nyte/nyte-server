{
  "name": "@use-nyte/nyte-server",
  "version": "0.0.0",
  "private": true,
  "description": "Nyte's self-hosted NestJS backend.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/use-nyte/nyte-server.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#server/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "docs:build": "typedoc",
    "format": "format",
    "format:write": "format --write",
    "lint": "lint",
    "lint:fix": "lint --fix",
    "prepare": "husky",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:mutation": "stryker run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.17",
    "@nestjs/testing": "12.6.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.11",
    "@types/supertest": "7.2.1",
    "@use-nyte/eslint-config": "2.1.1",
    "@use-nyte/prettier-config": "2.0.5",
    "@vitest/coverage-v8": "5.1.2",
    "husky": "9.1.7",
    "supertest": "7.3.2",
    "typedoc": "0.28.20",
    "typedoc-docusaurus-theme": "1.4.3",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.13.1"
  }
}
